/* Base QWidget */
QWidget {
    background-color: #ffffff;  /* พื้นหลังขาว */
    color: #333333;            /* สีตัวอักษรเข้มขึ้นเล็กน้อย */
    font-family: 'Arial';
    font-size: 16px;
}

/* Header */
QLabel#Header {
    color: #004085;            /* ฟ้าเข้ม */
    font-size: 28px;
    font-weight: bold;
    padding: 10px;
}

/* Video Display */
QLabel#VideoDisplay {
    border: 2px dashed #007bff; /* ขอบฟ้า */
    background-color: #ffffff;  /* พื้นหลังขาว */
    color: #004085;            /* ตัวอักษรฟ้าเข้ม */
    padding: 10px;
}

/* Status Label */
QLabel#StatusLabel {
    color: #5a7399;            /* ฟ้าเทา */
    font-size: 14px;
    margin: 8px;
}

/* Default Button (ถ้าไม่ได้กำหนด ObjectName) */
QPushButton {
    background-color: #e6e6e6; /* เทาอ่อน */
    color: #333333;            /* ตัวอักษรเข้ม */
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 13px;
}

/* Main Buttons (ฟ้า) */
QPushButton#MainButton {
    background-color: #007bff; /* ฟ้า */
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#MainButton:hover {
    background-color: #3399ff; /* ฟ้าสว่าง */
}
QPushButton#MainButton:pressed {
    background-color: #0056b3; /* ฟ้าเข้ม */
}

/* Light Blue Buttons (เดิม YellowButton) */
QPushButton#YellowButton {
    background-color: #66b0ff; /* ฟ้าอ่อน */
    color: #333333;            /* ตัวอักษรเข้ม */
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#YellowButton:hover {
    background-color: #80bdff; /* ฟ้าอ่อนสว่าง */
}
QPushButton#YellowButton:pressed {
    background-color: #4d94ff; /* ฟ้าอ่อนเข้ม */
}

/* Dark Blue Button (เดิม RedButton) */
QPushButton#RedButton {
    background-color: #004085; /* ฟ้าเข้ม */
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#RedButton:hover {
    background-color: #3366cc; /* ฟ้าสว่าง */
}
QPushButton#RedButton:pressed {
    background-color: #003087; /* ฟ้าเข้มมาก */
}

/* Blue Button (เดิม GreenButton) */
QPushButton#GreenButton {
    background-color: #007bff; /* ฟ้า */
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
    border: none;
}
QPushButton#GreenButton:hover {
    background-color: #3399ff; /* ฟ้าสว่าง */
}
QPushButton#GreenButton:pressed {
    background-color: #0056b3; /* ฟ้าเข้ม */
}

/* ======================== */
/* 🎨 Polygon Table Style   */
/* ======================== */

QTableWidget {
    background-color: #ffffff;        /* พื้นหลังขาว */
    color: #004085;                   /* ตัวอักษรฟ้าเข้ม */
    gridline-color: #cccccc;          /* เส้นตารางสีเทาอ่อน */
    border: 2px solid #007bff;        /* ขอบฟ้า */
    border-radius: 6px;
}
QHeaderView::section {
    background-color: #f1f1f1;        /* พื้นหลัง header เทาอ่อน */
    color: #004085;                   /* ตัวอักษรฟ้าเข้ม */
    font-weight: bold;
    padding: 6px;
    border: 1px solid #cccccc;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #007bff;        /* ฟ้าเมื่อเลือก */
    color: white;
}

/* ScrollBar */
QScrollBar:vertical {
    background: #f1f1f1;              /* พื้นหลังเทาอ่อน */
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #007bff;              /* ฟ้า */
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #3399ff;              /* ฟ้าสว่าง */
}