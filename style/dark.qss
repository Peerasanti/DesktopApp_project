/* Base QWidget */
QWidget {
    background-color: #121212;
    color: #e0f2e9;
    font-family: 'Arial';
    font-size: 16px;
}

/* Header */
QLabel#Header {
    color: #00ff66;
    font-size: 28px;
    font-weight: bold;
    padding: 10px;
}

/* Video Display */
QLabel#VideoDisplay {
    border: 2px dashed #00cc66;
    background-color: #1e1e1e;
    color: #aaffcc;
    padding: 10px;
}

/* Status Label */
QLabel#StatusLabel {
    color: #cccccc;
    font-size: 14px;
    margin: 8px;
}

/* Default Button (ถ้าไม่ได้กำหนด ObjectName) */
QPushButton {
    background-color: #333333;
    color: #e0ffe0;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 13px;
}

/* Main Buttons (ฟ้า) */
QPushButton#MainButton {
    background-color: #0066cc;
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#MainButton:hover {
    background-color: #3385ff;
}
QPushButton#MainButton:pressed {
    background-color: #004c99;
}

/* Yellow Buttons (เลือกวิดีโอ/กล้อง) */
QPushButton#YellowButton {
    background-color: #e6b800;
    color: black;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#YellowButton:hover {
    background-color: #ffd11a;
}
QPushButton#YellowButton:pressed {
    background-color: #b38f00;
}

/* Red Button (ล้างข้อมูล) */
QPushButton#RedButton {
    background-color: #cc0000;
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
}
QPushButton#RedButton:hover {
    background-color: #ff1a1a;
}
QPushButton#RedButton:pressed {
    background-color: #990000;
}

/* Green Button */
QPushButton#GreenButton {
    background-color: #009933;
    color: white;
    border-radius: 8px;
    font-size: 13px;
    padding: 6px 14px;
    min-height: 32px;
    font-weight: bold;
    border: none;
}
QPushButton#GreenButton:hover {
    background-color: #00cc44;
}
QPushButton#GreenButton:pressed {
    background-color: #006622;
}

/* ======================== */
/* 🎨 Polygon Table Style   */
/* ======================== */

QTableWidget {
    background-color: #111;         /* พื้นหลังดำ */
    color: #00FF88;                 /* ตัวอักษรเขียว */
    gridline-color: #00aa55;        /* เส้นตารางสีเขียวเข้ม */
    border: 2px solid #00ff88;
    border-radius: 6px;
}
QHeaderView::section {
    background-color: #222;
    color: #00FF88;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #00aa55;
}
QTableWidget::item {
    padding: 4px;
}
QTableWidget::item:selected {
    background-color: #00aa55;
    color: black;
}

/* ScrollBar */
QScrollBar:vertical {
    background: #111;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #00FF88;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #00cc66;
}

QComboBox#ThemeDropdown {
    background-color: #ffffff;
    color: #333;
    border: 1px solid #aaaaaa;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
}

QComboBox#ThemeDropdown:hover {
    border: 1px solid #666666;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #333;
    selection-background-color: #b5d5f5;
    selection-color: black;
    border: 1px solid #aaaaaa;
}

QComboBox {
    background-color: #1e1e1e;
    color: #e0f2e9;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
}
QComboBox:hover {
    border: 1px solid #00cc66;
}
QComboBox:drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #444;
    background: #2a2a2a;
}
QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: #e0f2e9;
    selection-background-color: #00aa55;
    selection-color: black;
    border: 1px solid #444;
}

/* Line Edit / Text Field */
QLineEdit {
    background-color: #1e1e1e;
    border: 1px solid #444;
    border-radius: 6px;
    padding: 6px;
    color: #e0f2e9;
    font-size: 14px;
}
QLineEdit:focus {
    border: 1px solid #00cc66;
    background-color: #262626;
}

/* Frame (ใช้เป็น Card) */
QFrame {
    background-color: #1a1a1a;
    border: 1px solid #333;
    border-radius: 10px;
}
QFrame QLabel {
    color: #e0f2e9;
    font-size: 14px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #444;
    background: #121212;
    border-radius: 6px;
}
QTabBar::tab {
    background: #1e1e1e;
    color: #e0f2e9;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #00aa55;
    color: black;
}
QTabBar::tab:hover {
    background: #2a2a2a;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #444;
    border-radius: 6px;
    background: #1e1e1e;
    text-align: center;
    color: #e0f2e9;
}
QProgressBar::chunk {
    background-color: #00cc66;
    border-radius: 6px;
}

/* ScrollBar Horizontal */
QScrollBar:horizontal {
    background: #111;
    height: 12px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #00FF88;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #00cc66;
}
