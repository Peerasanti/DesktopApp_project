/* ======================== */
/* ☀️ Base Light Theme      */
/* ======================== */
QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
    font-family: 'Arial';
    font-size: 16px;
}

/* Header */
QLabel#Header {
    color: #0066cc;
    font-size: 28px;
    font-weight: bold;
    padding: 10px;
}

/* ======================== */
/* 🔘 Buttons               */
/* ======================== */
QPushButton {
    background-color: #e6e6e6;
    color: #1a1a1a;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 13px;
}

/* GreenButton */
QPushButton#GreenButton {
    background-color: #28a745;   
    color: white;
    font-weight: bold;
}
QPushButton#GreenButton:hover {
    background-color: #4cd964;  
}
QPushButton#GreenButton:pressed {
    background-color: #1e7e34;   
}

/* Yellow Button */
QPushButton#YellowButton {
    background-color: #e6b800;
    color: black;
    font-weight: bold;
}
QPushButton#YellowButton:hover {
    background-color: #ffd11a;
}
QPushButton#YellowButton:pressed {
    background-color: #b38f00;
}

/* Red Button */
QPushButton#RedButton {
    background-color: #cc0000;
    color: white;
    font-weight: bold;
}
QPushButton#RedButton:hover {
    background-color: #ff1a1a;
}
QPushButton#RedButton:pressed {
    background-color: #990000;
}

/* Main Button */
QPushButton#MainButton {
    background-color: #0099ff;
    color: white;
    font-weight: bold;
    border: none;
}
QPushButton#MainButton:hover {
    background-color: #33adff;
}
QPushButton#MainButton:pressed {
    background-color: #0066b3;
}

/* ======================== */
/* 📊 Table                 */
/* ======================== */
QTableWidget {
    background-color: #ffffff;
    color: #004c99;
    gridline-color: #3399ff;
    border: 2px solid #3399ff;
    border-radius: 6px;
}
QTableCornerButton::section {
    background-color: #e6f2ff;
    color: #004c99;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #3399ff;  
    margin: 0;
    padding: 0; 
}
QHeaderView::section {
    background-color: #e6f2ff;
    color: #004c99;
    font-weight: bold;
    padding: 6px;
    border: 1px solid #3399ff;
}
QTableWidget::item:selected {
    background-color: #66b3ff;
    color: white;
}

/* ======================== */
/* ⬇️ ComboBox (Light)      */
/* ======================== */
QComboBox {
    background-color: #ffffff;
    color: #1a1a1a;
    border: 1px solid #aaa;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
}
QComboBox:hover {
    border: 1px solid #3399ff;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #aaa;
    background: #f0f0f0;
}
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1a1a;
    selection-background-color: #66b3ff;
    selection-color: white;
    border: 1px solid #aaa;
}

/* ======================== */
/* ✏️ LineEdit              */
/* ======================== */
QLineEdit {
    background-color: #ffffff;
    border: 1px solid #aaa;
    border-radius: 6px;
    padding: 6px;
    color: #1a1a1a;
    font-size: 14px;
}
QLineEdit:focus {
    border: 1px solid #3399ff;
    background-color: #f0f8ff;
}

/* ======================== */
/* 📦 Card (QFrame)         */
/* ======================== */
QFrame {
    background-color: #ffffff;
    border: 1px solid #ccc;
    border-radius: 10px;
}
QFrame QLabel {
    color: #1a1a1a;
    font-size: 14px;
}

/* ======================== */
/* 🖱 ScrollBar             */
/* ======================== */
QScrollBar:vertical {
    background: #f0f0f0;
    width: 12px;
}
QScrollBar::handle:vertical {
    background: #3399ff;
    min-height: 20px;
    border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: #0073e6;
}

QScrollBar:horizontal {
    background: #f0f0f0;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #3399ff;
    min-width: 20px;
    border-radius: 6px;
}
QScrollBar::handle:horizontal:hover {
    background: #0073e6;
}
